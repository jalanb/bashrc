#! /bin/bash
#
# Link this project into home
#
# This script must be in a git repo
# Link this script's directory into $HOME
#     for example, if repo was cloned to ~/src/git/hub/repo then
#         cd $HOME; ln -s ~/src/git/hub/repo .
#     Todo: option to use repo name instead of directory name
#
# Link a list of known config files and dirs, mostly to dot (hidden) links
#     hence the name of this file
# TODO: Generalise (currently based on layout of this repo)
#
# See also https://github.com/jalanb/jab/commit/6e2e26b455b78a7da51a5e977d7f3fa3c098ddec

SCRIPT_FILE=$(readlink -f $BASH_SOURCE)

link_clone_to_home () {
    link_into_home "$HOME_CLONE"/$1 $2
}

link_into_home () {
    source="$1"
    destination="$HOME"/$2
    [[ -e "$destination" || -L "$destination" ]] && rm -rf "$destination"
    if test -f "$destination"; then
        if diff "$source" "$destination" >/dev/null 2>&1; then
            vim -d "$source" "$destination"
        fi
        rm -f "$destination"
    fi
    ln -s "$source" "$destination"
}

links_into_home () {
    cd $HOME
    link_clone_to_home home/gitconfig             .gitconfig
    link_clone_to_home home/gitignore_global      .gitignore_global
    link_clone_to_home home/bashprofile           .bash_profile
    link_clone_to_home home/bashrc                .bashrc
    link_clone_to_home home/vimrc                 .vimrc
    link_clone_to_home home/ackrc                .ackrc
    link_clone_to_home home/editrc               .editrc
    link_clone_to_home home/inputrc              .inputrc
    link_clone_to_home home/sackrc               .sackrc
    link_clone_to_home home/tmuxrc               .tmux.conf
    link_clone_to_home home/xonshrc              .xonshrc
    link_clone_to_home home/gvimrc               .gvimrc
    link_clone_to_home home/dir_colors           .dir_colors
    link_clone_to_home home/vim                  .vim

    link_into_home ~/src/git/hub        hub
    link_into_home $HOME_CLONE/src/bash       bash
    link_into_home ~/bash/keyboard      keys

    link_clone_to_home home/pythonrc.py           .pythonrc.py
    link_clone_to_home home/ipython              .ipython
    link_into_home $HOME_CLONE/src/python     python
}

get_git_dir () {
    local script_dir=$(dirname $1)
    local git_dir=$(git -C "$script_dir" rev-parse --git-dir 2>/dev/null)
    if [[ ! $git_dir ]]; then
        echo $SCRIPT_FILE assumes it is in a git clone
        echo Could not find .git/
        return 2
    fi
    echo $git_dir
}

renew_clone_link () {
    local git_dir=$(get_git_dir $SCRIPT_FILE)
    [[ $git_dir ]] || return 2
    local clone_dir=$(dirname $git_dir)

    HOME_CLONE=~/$(basename $clone_dir)  # Assume we want the clone's name
    [[ $1 ]] && HOME_CLONE=~/$1                    # Override with $1 if given
    local script_name=$(basename $SCRIPT_FILE)   # ".link"
    local script_dir=$(basename $(dirname $SCRIPT_FILE))        # "home"
    local linked_script=$HOME_CLONE/$script_dir/$script_name
    [[ -f $linked_script ]] && return 0
    [[ -h $HOME_CLONE ]] && rm -f $HOME_CLONE
    [[ -d $HOME_CLONE ]] && mv $HOME_CLONE ${HOME_CLONE}~
    ln -s $clone_dir $HOME_CLONE
    if [[ ! -f $linked_script ]]; then
        echo $linked_script is not a file >&2
        return 1
    fi
    return 0
}

renew_clone_link "$1" && links_into_home
