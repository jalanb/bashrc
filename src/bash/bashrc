#! /usr/local/bin/bash -x

.b () {
    jab_source __init__.sh || return 1
    jab_source src/bash/prompt.sh green
}

lcolour () {
    local colour_="[1;${1}m"
    local no_colour_="[0m"
    shift
    echo "${colour_}$*${no_colour_}"
}

lred () {
    lcolour 31 "$@"
}

lgreen () {
    lcolour 32 "$@"
}

lblue () {
    lcolour 34 "$@"
}

quietly () {
    "$@" 2>/dev/null
}

QUIETLY () {
    "$@" 1>/dev/null 2>&1
}

usr_local () {
    echo "/usr/local/$1"
}

set_paths () {
    local homes_=$HOME/jab/bin:$HOME/bin:$HOME/.local/bin
    local locals_="$(usr_local gnu):/opt/homebrew/bin:$(usr_local bin):$(usr_local opt):$(usr_local go/bin)"
    local bins_=/opt/uv/bin:/usr/bin:/bin:/usr/sbin:/sbin
    local mysite_=/Users/jab/jab/src/python/site/

    local all_="$homes_:$locals_:$bins_"
    PATH=$all_; export PATH
    PYTHONPATH=$mysite_:$PYTHONPATH;

    if test -d $HOME/lib -a -n "$(find $HOME/lib -maxdepth 1 -name 'libpython*' -print -quit)"; then
        export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$HOME/lib
    fi
}

luser () {
    echo "$(lusername)@$(lhost)"
}

lusername () {
    lblue "${USER:-$(whoami)}"
}

lhost () {
    lred "${HOSTNAME:-$(hostname -s)}"
}

lhere () {
    lgreen "$(readlink -f .)"
}

jab_source () {
    bashr_source "~/jab/$1"
}

bashr_source () {
    [[ -f "$1" ]] || return 1
    source "$1"
}

bashr_log=~/log/bashrc.log

bashrc () {
    /usr/bin/say -v Anna Ich möchte eine Maschine, die schreiben kann, wie ich kann
    PS1="\$? [$(luser):$(lhere)]\n$ "; export PS1
    PS4='+ [${BASH_SOURCE##*/}::${FUNCNAME[0]}():${LINENO}] ' ; export PS4
    cd ~/jab || return 1
    bashr_source bash/bashrc_minimal
    bashr_source __init__.sh || return 1
    bashr_source src/bash/prompt.sh green
    quietly cd - || return 0
}

minrc () {
    local min_=~/jab/bash/bashrc_minimal
    vim $min_
    bashr_source "$min_"
}

__main__ () {
    set_paths
    bashrc
    set +m
}

post_main () {
    if [[ $PWD != /opt/clones/github/jalanb ]]; then
        show_command cd -
        grey_line "#    -> '$PWD'"
    fi
    show_command cd /opt/clones/github/jalanb/
    cd /opt/clones/github/jalanb/ || return 1
    bashr_source .venv/bin/activate
    l
}

if [[ ! $CLAUDECODE ]]; then
    if [[ $- =~ i ]]; then
        set -x;
        __main__ "$@" > $bashr_log 2>&1
        set +x
        post_main
    else
        __main__  "$@"
    fi
fi

echo_if_file () {
    [[ -f "$1" ]] || return 1
    echo "        $1"
}

bbb () {
    echo ""
    echo_if_file ~/.bashrc
    echo_if_file ~/.minimal
    echo_if_file ~/.vimrc
    echo_if_file ~/jab/__init__.sh
    echo_if_file ~/jab/environ.d/__init__.sh
    echo_if_file ~/jab/src/bash/__init__.sh
    echo_if_file ~/jab/local/__init__.sh
    echo_if_file ~/jalanb/local/__init__.sh
    echo_if_file $bashr_log
}


vbb () {
    # This function works best last
    bbb_="$(bbb)"
    vim -p "$bbb_"
    quietly readlink -f "$(bbb)" 
}
