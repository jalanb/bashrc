#! /usr/local/bin/bash -x

.b () {
    local jab_=$HOME/jab
    [[ $1 == "-m" ]] && bashrc_source $jab_/bash/bashrc_minimal
    bashrc_source $jab_/__init__.sh || return 1
    bashrc_source $jab_/src/bash/prompt.sh green
}

lcolour () {
    local colour_="[1;${1}m" no_colour_="[0m"
    shift
    local text_="$@"
    printf "${colour_}${text_}${no_colour_}"
}

lred () {
    lcolour 31 "$@"
}

lgreen () {
    lcolour 32 "$@"
}

lblue () {
    lcolour 34 "$@"
}

QUIETLY () {
    "$@" 2>/dev/null 1>&2
}

quietly () {
    "$@" 2>/dev/null
}

QUIETLY () {
    "$@" 1>/dev/null 2>&1
}

usr_local () {
    echo "/usr/local/$1"
}

set_paths () {
    local homes_=$HOME/jab/bin:$HOME/bin:$HOME/.local/bin
    local locals_="$(usr_local gnu):/opt/homebrew/bin:$(usr_local bin):$(usr_local opt):$(usr_local go/bin)"
    local bins_=/opt/uv/bin:/usr/bin:/bin:/usr/sbin:/sbin
    local mysite_=/Users/jab/jab/src/python/site/

    local all_="$homes_:$locals_:$bins_"
    PATH=$all_; export PATH
    PYTHONPATH=$mysite_:$PYTHONPATH;

    if test -d $HOME/lib -a -n "$(find $HOME/lib -maxdepth 1 -name 'libpython*' -print -quit)"; then
        export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$HOME/lib
    fi
}

luser () {
    printf $(lusername)@$(lhost)
}

lusername () {
    lblue "${USER:-$(whoami)}"
}

lhost () {
    lred ${HOSTNAME:-$(hostname -s)}
}

lhere () {
    lgreen $(readlink -f $PWD)
}

bashrc_source () {
    [[ -f "$1" ]] || return 1
    source "$@"
}

echo_if_file () {
    [[ -f "$1" ]] || return 1
    echo "        $1"
}

bashrc_log=$HOME/log/bashrc.log

bbb () {
    echo ""
    echo_if_file $HOME/.bashrc
    echo_if_file $HOME/jab/__init__.sh
    echo_if_file $HOME/jab/environ.d/__init__.sh
    echo_if_file $HOME/jab/src/bash/__init__.sh
    echo_if_file $HOME/jab/local/__init__.sh
    echo_if_file $HOME/jalanb/local/__init__.sh
    echo_if_file $HOME/.vimrc
    echo_if_file $bashrc_log
    echo_if_file $HOME/jab/bash/bashrc_minimal
}

bashrc () {
    # /usr/bin/say -v Anna Ich möchte eine Maschine, die schreiben kann, wie ich kann
    export PS1="\$? [$(luser):$(lhere)]\n$ "
    export PS4='+ [${BASH_SOURCE##*/}::${FUNCNAME[0]}():${LINENO}] '
    local jab_=$HOME/jab
    bashrc_source $jab_/bash/bashrc_minimal
    bashrc_source $jab_/__init__.sh || return 1
    bashrc_source $jab_/src/bash/prompt.sh green
}

min () {
    local min_=~/jab/bash/bashrc_minimal
    vim $min_
    . $min_
}

__main__ () {
    set_paths
    bashrc
    set +m
}

post_main () {
    show_command cd -
    grey_line "#    -> '$PWD'"
    show_command cd /opt/clones/github/jalanb/
    cd /opt/clones/github/jalanb/
    l
}

vbb () {
    local __doc__="""Must be last function to over-write same func from bashrc_minimal"""
    vim -p $(bbb)
    readlink -f $(bbb) 2>/dev/null
}

if [[ ! $CLAUDECODE ]]; then
    if [[ $- =~ i ]]; then
        set -x;
        __main__ "$@" > $bashrc_log 2>&1
        set +x
        post_main
    else
        __main__  "$@"
    fi
fi
